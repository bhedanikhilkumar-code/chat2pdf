{
  "name": "chat2pdf",
  "version": "1.0.0",
  "description": "Export AI chat conversations to multiple formats (PDF, PPTX, CSV, TXT, MD, Image, DOCX, Handwriting)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build:extension": "npm run build:web:ext && vite build --config vite.config.ext.ts && node scripts/finalize-extension.js",
    "build": "npm run build:web && npm run build:extension",
    "build:web:ext": "vite build --mode extension --outDir dist-web-ext"
  },
  "keywords": [],
  "dependencies": {
    "docx": "^9.15.3",
    "dompurify": "^3.4.17",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "katex": "^0.19.1",
    "marked": "^18.2.0",
    "papaparse": "^5.7.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-precaching": "^7.4.1"
  }
}
